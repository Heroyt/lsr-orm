{
  "name": "lsr/orm",
  "license": "MIT",
  "description": "Laser framework core - ORM",
  "version": "0.4.0",
  "repositories": [
    {
      "type": "composer",
      "url": "https://packages.laserliga.cz"
    }
  ],
  "scripts": {
    "test": "XDEBUG_MODE=coverage php -d memory_limit=1G ./vendor/bin/phpunit",
    "docs": "doxygen",
    "phpstan": "./vendor/bin/phpstan",
    "cs:fix": "./vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php",
    "cbf": "@cs:fix",
    "cs": "./vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "phpunit/phpunit": "^12",
    "phpstan/phpstan": "^2.0",
    "phpstan/extension-installer": "^1.2",
    "phpstan/phpstan-dibi": "^2.0",
    "phpstan/phpstan-nette": "^2.0",
    "jetbrains/phpstorm-attributes": "^1.2",
    "fakerphp/faker": "^1.24",
    "friendsofphp/php-cs-fixer": "^3.95",
    "symfony/console": "^8|^7"
  },
  "autoload": {
    "psr-4": {
      "Lsr\\Orm\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "TestCases\\": "tests/TestCases/",
      "Mocks\\": "tests/Mocks/"
    }
  },
  "authors": [
    {
      "name": "Tom\u00e1\u0161 Voj\u00edk",
      "email": "vojik@wboy.cz"
    }
  ],
  "minimum-stability": "stable",
  "require": {
    "php": ">=8.4",
    "nette/di": "^3.2",
    "lsr/logging": "^0.3.2",
    "psr/log": "^1.0 || ^2.0 || ^3.0",
    "lsr/caching": "^0.3",
    "lsr/serializer": "^0.3",
    "lsr/db": "^0.3.1",
    "lsr/object-validation": "^0.3.4"
  },
  "suggest": {
    "lsr/console": "Loads the orm:cache:clean command into the framework console."
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  },
  "extra": {
    "branch-alias": {
      "v0.3": "0.3.x-dev"
    }
  }
}